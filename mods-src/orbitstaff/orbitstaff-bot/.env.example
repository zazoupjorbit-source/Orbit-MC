# =====================================================================
#  OrbitStaff Bot Discord - variables d'environnement (modele)
#  Copier vers .env (jamais commit). Le bot parle uniquement a l'API.
# =====================================================================

# --- Discord ---
DISCORD_BOT_TOKEN=change-me-discord-bot-token
DISCORD_APP_ID=change-me-application-id
DISCORD_GUILD_ID=change-me-guild-id

# --- API OrbitStaff (jamais MariaDB directement) ---
ORBITSTAFF_BOT_API_URL=http://127.0.0.1:8085
ORBITSTAFF_BOT_SERVICE_KEY=oss_change-me-bot-service-key
ORBITSTAFF_SERVER_ID=srv-main

# --- Autorisation (identifiants Discord, separes par des virgules) ---
# Roles autorises a utiliser /mod et /player. Vide = aucun filtrage (a eviter).
ORBITSTAFF_STAFF_ROLE_IDS=
# Salons de publication des journaux (optionnel).
ORBITSTAFF_LOG_CHANNEL_IDS=

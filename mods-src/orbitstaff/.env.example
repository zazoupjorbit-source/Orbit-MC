# =====================================================================
#  OrbitStaff - Variables d'environnement (modele)
#  Copier vers .env et renseigner les valeurs reelles.
#  Le fichier .env NE DOIT JAMAIS etre commit (voir .gitignore).
#  Chaque service a des identifiants distincts (principe du moindre privilege).
# =====================================================================

# ---------------------------------------------------------------------
#  Base de donnees MariaDB (accessible UNIQUEMENT par orbitstaff-api)
# ---------------------------------------------------------------------
ORBITSTAFF_DB_HOST=127.0.0.1
ORBITSTAFF_DB_PORT=3306
ORBITSTAFF_DB_NAME=orbitstaff
ORBITSTAFF_DB_USER=orbitstaff_app
ORBITSTAFF_DB_PASSWORD=change-me-strong-password
# Mot de passe root MariaDB, utilise seulement par docker-compose au provisioning
ORBITSTAFF_DB_ROOT_PASSWORD=change-me-root-password

# ---------------------------------------------------------------------
#  API (orbitstaff-api - Spring Boot)
# ---------------------------------------------------------------------
ORBITSTAFF_API_PORT=8085
# Origine autorisee pour un futur panel web (CORS). Vide = desactive.
ORBITSTAFF_API_ALLOWED_ORIGINS=
# Cle HMAC serveur pour signer les tokens internes / correler les requetes.
# Generer 64+ caracteres aleatoires. Ne jamais reutiliser entre environnements.
ORBITSTAFF_API_SIGNING_SECRET=change-me-64-random-chars

# ---------------------------------------------------------------------
#  Compte de service du PLUGIN Minecraft (orbitstaff-core -> API)
#  La cle est generee par l'API (voir docs/security.md). Le plugin ne
#  stocke QUE cette cle, jamais le mot de passe MariaDB ni le token Discord.
# ---------------------------------------------------------------------
ORBITSTAFF_CORE_SERVER_ID=srv-main
ORBITSTAFF_CORE_API_URL=http://127.0.0.1:8085
ORBITSTAFF_CORE_SERVICE_KEY=oss_change-me-service-key

# ---------------------------------------------------------------------
#  Compte de service du BOT Discord (orbitstaff-bot -> API)
#  Le bot ne se connecte JAMAIS directement a MariaDB.
# ---------------------------------------------------------------------
DISCORD_BOT_TOKEN=change-me-discord-bot-token
DISCORD_APP_ID=change-me-application-id
DISCORD_GUILD_ID=change-me-guild-id
ORBITSTAFF_BOT_API_URL=http://127.0.0.1:8085
ORBITSTAFF_BOT_SERVICE_KEY=oss_change-me-bot-service-key

# ---------------------------------------------------------------------
#  Stockage des preuves (abstraction EvidenceStorage)
#  local = disque abstrait pour le developpement ; s3 = compatible S3 en prod.
# ---------------------------------------------------------------------
ORBITSTAFF_EVIDENCE_BACKEND=local
ORBITSTAFF_EVIDENCE_LOCAL_PATH=./evidence-store
# ORBITSTAFF_EVIDENCE_S3_ENDPOINT=
# ORBITSTAFF_EVIDENCE_S3_BUCKET=
# ORBITSTAFF_EVIDENCE_S3_ACCESS_KEY=
# ORBITSTAFF_EVIDENCE_S3_SECRET_KEY=

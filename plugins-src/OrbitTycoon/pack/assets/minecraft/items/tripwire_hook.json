{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
    {"when": "cle_cryo", "model": {"type": "minecraft:model", "model": "orbittycoon:item/cle_cryo"}},
    {"when": "cle_solaire", "model": {"type": "minecraft:model", "model": "orbittycoon:item/cle_solaire"}},
    {"when": "cle_nebuleuse", "model": {"type": "minecraft:model", "model": "orbittycoon:item/cle_nebuleuse"}},
    {"when": "cle_asteroide", "model": {"type": "minecraft:model", "model": "orbittycoon:item/cle_asteroide"}},
    {"when": "cle_reacteur", "model": {"type": "minecraft:model", "model": "orbittycoon:item/cle_reacteur"}}
    ],
    "fallback": {"type": "minecraft:model", "model": "minecraft:item/tripwire_hook"}
  }
}
